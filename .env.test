# Test environment configuration for civi-py
# Used by: make test-integration
#
# For local development with Docker infrastructure:
#   make infra-up
#   make infra-install  (first time only)
#   make infra-setup
#
# These values work with the CiviCRM Standalone docker-compose.yml

CIVI_BASE_URL=http://localhost:8080/civicrm/ajax/api4
CIVI_API_KEY=test-api-key-civi-py
CIVI_TIMEOUT=30
CIVI_VERIFY_SSL=false
CIVI_DEBUG=true
CIVI_MAX_RETRIES=3
