# CiviCRM API Configuration
# Copy this file to .env and configure for your environment

# CiviCRM API Base URL (required)
# The base URL for CiviCRM API v4 endpoints
CIVI_BASE_URL=http://localhost:8080/civicrm/ajax/api4

# API Key (required for API key authentication)
CIVI_API_KEY=your-api-key-here

# Site Key (optional, depends on CiviCRM configuration)
CIVI_SITE_KEY=your-site-key-here

# Authentication type: api_key, jwt, or basic
CIVI_AUTH_TYPE=api_key

# Request timeout in seconds
CIVI_TIMEOUT=30

# SSL verification (set to false for local development)
CIVI_VERIFY_SSL=true

# Debug mode (enables verbose logging)
CIVI_DEBUG=false

# Flask Configuration
FLASK_APP=app:create_app
FLASK_DEBUG=true
FLASK_SECRET_KEY=change-me-in-production
