# civi-py Environment Configuration
# Copy this file to .env and customize for your environment
#
# For local development with Docker infrastructure:
#   make infra-up       # Start containers
#   make infra-install  # Install CiviCRM (first time only)
#   make infra-setup    # Configure API key
#
# See infra/README.md for full documentation

# =============================================================================
# Required Settings
# =============================================================================

# CiviCRM API v4 endpoint URL
# Format: https://your-site.org/civicrm/ajax/api4
CIVI_BASE_URL=http://localhost:8080/civicrm/ajax/api4

# API Key for authentication
# Generate in CiviCRM: Administer > Users and Permissions > API Keys
CIVI_API_KEY=your-api-key-here

# =============================================================================
# Optional Settings
# =============================================================================

# Site Key (required for some CiviCRM installations)
# Found in civicrm.settings.php
# CIVI_SITE_KEY=your-site-key-here

# Request timeout in seconds (default: 30)
CIVI_TIMEOUT=30

# SSL certificate verification (default: true)
# Set to false only for local development
CIVI_VERIFY_SSL=true

# Enable debug logging (default: false)
CIVI_DEBUG=false

# Maximum retry attempts for failed requests (default: 3)
CIVI_MAX_RETRIES=3

# Authentication type: api_key, jwt, or basic (default: api_key)
# CIVI_AUTH_TYPE=api_key

# AuthX flow: header (Authorization) or xheader (X-Civi-Auth) (default: header)
# Use xheader when your host strips the Authorization header (common on WordPress/Apache)
# CIVI_AUTH_FLOW=header

# =============================================================================
# JWT Authentication (if using CIVI_AUTH_TYPE=jwt)
# =============================================================================

# JWT token for authentication
# CIVI_JWT_TOKEN=your-jwt-token-here

# =============================================================================
# Basic Authentication (if using CIVI_AUTH_TYPE=basic)
# =============================================================================

# Username for basic auth
# CIVI_USERNAME=your-username

# Password for basic auth
# CIVI_PASSWORD=your-password
